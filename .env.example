# GRILLVI Restaurant Environment Variables Example

# Application Domain (used for QR code URLs and shareable order links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Restaurant WhatsApp Phone (format: country code without +)
NEXT_PUBLIC_WHATSAPP_PHONE=923141915087

# Generate a unique random secret of at least 32 characters.
JWT_SECRET=

# Initial admin credentials (use a unique password of at least 12 characters)
ADMIN_DEFAULT_USER=GRILLVI
ADMIN_DEFAULT_PASS=

# Supabase persistence for admin credentials and payment settings
# Run supabase/schema.sql in the Supabase SQL Editor before enabling these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Object Storage for Cloud Deployment (Optional: Cloudinary / Supabase / AWS S3)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
